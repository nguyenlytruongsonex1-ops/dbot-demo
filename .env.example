# Sao chép file này thành .env rồi sửa nếu cần. Không commit file .env.
POSTGRES_PASSWORD=dbot
UI_PORT=8501
PG_PORT_HOST=5432
TPCH_SF=0.1

# Nguồn LLM mặc định: claude, gemini, openai, ollama hoặc mock (không dùng LLM, để thử luồng).
# Nếu nguồn đã chọn không có API key hoặc gọi lỗi, hệ thống tự chuyển sang Ollama trên máy bạn.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Claude (Anthropic). Model mặc định kiểm tra ngày 15/10/2026.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Gemini (Google AI Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI hoặc API tương thích OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Giám sát
MONITOR_INTERVAL=5
ANALYZE_DEBOUNCE_SEC=20
