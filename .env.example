# Sao chép file này thành .env rồi sửa nếu cần.
POSTGRES_PASSWORD=dbot
APP_PORT=8000

# LLM_PROVIDER: ollama (mặc định), openai (API tương thích OpenAI) hoặc mock (không dùng LLM, để thử luồng)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Chỉ dùng khi LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
TPCH_SF=0.1
