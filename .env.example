POSTGRES_USER=dbot
POSTGRES_PASSWORD=dbot
POSTGRES_DB=dbot_demo
POSTGRES_PORT=5432
APP_PORT=8000

# mock = chạy không cần API key; openai = dùng CrewAI/LLM provider
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
# Optional OpenAI-compatible endpoint, e.g. http://host.docker.internal:1234/v1
OPENAI_API_BASE=

DBOT_MAX_ITERATIONS=8
DBOT_LOG_LEVEL=INFO
