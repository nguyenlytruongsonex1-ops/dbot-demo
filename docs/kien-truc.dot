digraph G {
  rankdir=LR; node [fontname="DejaVu Sans", shape=box, style="rounded,filled", fillcolor="#eef3f8"]; edge [fontname="DejaVu Sans", fontsize=10]; fontname="DejaVu Sans";
  subgraph cluster_docker { label="Docker Compose"; style=dashed;
    seed [label="tpch-seed\n(dbgen -s 0.1, COPY)", fillcolor="#fdf2d0"];
    pg [label="PostgreSQL 16\n(pg_stat_statements,\ndữ liệu TPC-H SF 0.1)", shape=cylinder, fillcolor="#dbe9d8"];
    mon [label="monitor\n(quét mỗi 5 giây)"];
    be [label="backend FastAPI\n(API nội bộ,\nchạy kịch bản)"];
    wk [label="dbot-worker\n(tự nhận alert,\nCrewAI 2 agent)"];
    st [label="streamlit :8501\n(tab 0 đến 6,\ntự làm mới 3 giây)", fillcolor="#f8e1e1"];
    sq [label="SQLite\n(alert, báo cáo,\ncài đặt)", shape=cylinder, fillcolor="#f6ecd5"];
    kb [label="knowledge/*.md\n(tri thức chẩn đoán)", shape=note, style=filled, fillcolor="white"];
  }
  ui [label="Trình duyệt DBA", fillcolor="#f8e1e1"];
  cloud [label="Claude, Gemini, OpenAI\n(nếu có API key)", fillcolor="#e6e0f4"];
  ol [label="Ollama trên máy người dùng\n(dự phòng, qwen2.5:7b)", fillcolor="#e6e0f4"];
  seed -> pg [label="nạp dữ liệu một lần"];
  ui -> st [dir=both];
  st -> be [label="HTTP"];
  st -> pg [label="tab 1 đến 4"];
  be -> pg [label="chạy/dừng kịch bản"];
  mon -> pg [label="đọc thống kê"];
  mon -> sq [label="ghi alert"];
  be -> sq [dir=both];
  wk -> sq [label="nhận alert, lưu báo cáo", dir=both];
  wk -> pg [label="công cụ chỉ đọc"];
  wk -> kb;
  wk -> cloud; st -> cloud [style=dashed];
  wk -> ol [label="khi thiếu key hoặc lỗi"];
}
